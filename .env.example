APP_NAME=Baraly API
ENVIRONMENT=local
LOG_LEVEL=INFO
# JSON-список, например ["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000","https://baraly-frontend.vercel.app"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=baraly
POSTGRES_PASSWORD=change_me
POSTGRES_DB=baraly

# Сгенерируйте: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_string_of_32_chars_or_more
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# JSON-списки. Google: OAuth Client ID. Apple: Services ID для сайта, Bundle ID для iOS.
GOOGLE_CLIENT_IDS=[]
APPLE_CLIENT_IDS=[]

# Порты на хосте для docker compose
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432

# MinIO. Ключи служат и логином в консоль http://localhost:9001
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=baraly
S3_SECRET_KEY=change_me_min_8_chars
S3_BUCKET=baraly
S3_PUBLIC_URL=http://localhost:9000
MAX_IMAGE_SIZE_MB=10
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Бронирование
BOOKING_HOLD_MINUTES=15
# fake: тестовая оплата без денег, в production запрещена
PAYMENT_PROVIDER=fake
PUBLIC_API_URL=http://localhost:8000

